blob/b5d0f115c75ee74a7cdbfad533625a550a416fda/web/content/docs/benchmarks/small-deformations/ModifiedCamClay/ModifiedCamClay_report.pdf","locator":"Silbermann & Nagel, 28 June 2023: equations 14\u201317 and 30b; equation 11 prints M while 30b uses M squared. Section 3.1 hardening differs from atlas exponential log-pc update. Project discretization and normalization: docs/models/modified-cam-clay.md.","role":"formulation"},{"url":"https://docs.itascacg.com/itasca930/common/models/camclay/doc/modelcamclay.html","locator":"Equations 15, 18\u201325: stiffness, yield and associated flow; 31 and 8 have different finite-step hardening/volume updates. Initialization: 32 and 42. Not an executed cross-code comparison.","role":"formulation reference"}],"equations":{"sigma":"sigma - sigma_n - K * trace(de) * I - 2 * G * dev(de) + gamma * (6 * G * dev(sigma) / pc_n + K * M**2 * (2 * mean - pc) / pc_n * I)","e":"e - (1 + e_n) * exp(-trace(de)) + 1","pc":"pc - pc_n * exp((1 + e) * plastic_volume / (lambda_c - kappa))","gamma":"sqrt(gamma**2 + yield_scaled**2) - gamma + yield_scaled"},"initial_checks":["yield_scaled <= 1e-8"]}]}
